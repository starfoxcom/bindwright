{
<!-- TOGGLE:attribution_guard START -->
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
<!-- TOGGLE:attribution_guard END -->
<!-- TOGGLE:guard_hooks_repo START -->
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
<!-- TOGGLE:attribution_guard START -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" no-ai-attribution' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10,
            "onFailure": "block"
          },
<!-- TOGGLE:attribution_guard END -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" push-guard' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
<!-- TOGGLE:guard_hooks_repo END -->
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git merge:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git remote:*)",
      "Bash(git restore:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(node -e:*)",
      "Bash(python -c:*)",
      "Bash(date:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git fetch *--upl*)",
      "Bash(git pull *--upl*)",
      "Bash(git remote *--mi*)",
      "Bash(gh repo sync *--force*)",
      "Bash(git push * {{MAIN_BRANCH}})",
      "Bash(git push * {{MAIN_BRANCH}} *)",
      "Bash(git push *:{{MAIN_BRANCH}})",
      "Bash(git push *:{{MAIN_BRANCH}} *)",
      "Bash(git push * refs/heads/{{MAIN_BRANCH}})",
      "Bash(git push * refs/heads/{{MAIN_BRANCH}} *)",
      "Bash(git push *:refs/heads/{{MAIN_BRANCH}})",
      "Bash(git push *:refs/heads/{{MAIN_BRANCH}} *)",
<!-- TOGGLE:branching_model_gitflow START -->
      "Bash(git push * {{DEV_BRANCH}})",
      "Bash(git push * {{DEV_BRANCH}} *)",
      "Bash(git push *:{{DEV_BRANCH}})",
      "Bash(git push *:{{DEV_BRANCH}} *)",
      "Bash(git push * refs/heads/{{DEV_BRANCH}})",
      "Bash(git push * refs/heads/{{DEV_BRANCH}} *)",
      "Bash(git push *:refs/heads/{{DEV_BRANCH}})",
      "Bash(git push *:refs/heads/{{DEV_BRANCH}} *)",
<!-- TOGGLE:branching_model_gitflow END -->
      "Bash(git rebase -i*)",
      "Bash(git rebase * -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase * --interactive*)",
<!-- TOGGLE:deny_list_strict START -->
      "Bash(git reset --hard:*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean * -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean * -df*)",
      "Bash(git clean -xf*)",
      "Bash(git clean -dxf*)",
      "Bash(git clean -xdf*)",
      "Bash(git clean *--force*)",
      "Bash(git branch -D {{MAIN_BRANCH}})",
<!-- TOGGLE:branching_model_gitflow START -->
      "Bash(git branch -D {{DEV_BRANCH}})",
<!-- TOGGLE:branching_model_gitflow END -->
      "Bash(gh repo delete*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=delete*)",
<!-- TOGGLE:deny_list_strict END -->
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
