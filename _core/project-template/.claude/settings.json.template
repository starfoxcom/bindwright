{
<!-- TOGGLE:attribution_guard START -->
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
<!-- TOGGLE:attribution_guard END -->
<!-- TOGGLE:guard_hooks_repo START -->
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
<!-- TOGGLE:attribution_guard START -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" no-ai-attribution' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
<!-- TOGGLE:attribution_guard END -->
<!-- TOGGLE:version_check START -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" version-check' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
<!-- TOGGLE:version_check END -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" push-guard' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" tool-rules' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" live-check' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" tool-rules' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
<!-- TOGGLE:guard_hooks_repo END -->
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git fetch *--upl*)",
      "Bash(git pull *--upl*)",
      "Bash(git remote *--mi*)",
      "Bash(gh repo sync *--force*)",
      "Bash(git push * {{MAIN_BRANCH}})",
      "Bash(git push * {{MAIN_BRANCH}} *)",
      "Bash(git push *:{{MAIN_BRANCH}})",
      "Bash(git push *:{{MAIN_BRANCH}} *)",
      "Bash(git push * refs/heads/{{MAIN_BRANCH}})",
      "Bash(git push * refs/heads/{{MAIN_BRANCH}} *)",
      "Bash(git push *:refs/heads/{{MAIN_BRANCH}})",
      "Bash(git push *:refs/heads/{{MAIN_BRANCH}} *)",
<!-- TOGGLE:branching_model_gitflow START -->
      "Bash(git push * {{DEV_BRANCH}})",
      "Bash(git push * {{DEV_BRANCH}} *)",
      "Bash(git push *:{{DEV_BRANCH}})",
      "Bash(git push *:{{DEV_BRANCH}} *)",
      "Bash(git push * refs/heads/{{DEV_BRANCH}})",
      "Bash(git push * refs/heads/{{DEV_BRANCH}} *)",
      "Bash(git push *:refs/heads/{{DEV_BRANCH}})",
      "Bash(git push *:refs/heads/{{DEV_BRANCH}} *)",
<!-- TOGGLE:branching_model_gitflow END -->
      "Bash(git rebase -i*)",
      "Bash(git rebase * -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase * --interactive*)",
<!-- TOGGLE:precommit_hooks_scaffold START -->
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(LEFTHOOK=0 *)",
      "Bash(LEFTHOOK=false *)",
      "Bash(LEFTHOOK_EXCLUDE=*)",
      "Bash(HUSKY=0 *)",
      "Bash(SKIP=*)",
      "Bash(SKIP_SIMPLE_GIT_HOOKS=*)",
<!-- TOGGLE:precommit_hooks_scaffold END -->
<!-- TOGGLE:deny_list_strict START -->
      "Bash(git reset --hard:*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean * -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean * -df*)",
      "Bash(git clean -xf*)",
      "Bash(git clean -dxf*)",
      "Bash(git clean -xdf*)",
      "Bash(git clean *--force*)",
      "Bash(git branch -D {{MAIN_BRANCH}})",
<!-- TOGGLE:branching_model_gitflow START -->
      "Bash(git branch -D {{DEV_BRANCH}})",
<!-- TOGGLE:branching_model_gitflow END -->
      "Bash(gh repo delete*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=delete*)",
<!-- TOGGLE:deny_list_strict END -->
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
