# Husky pre-commit hook — fast, language-agnostic checks before each commit
# https://typicode.github.io/husky
#
# Activate in this repo: npm install --save-dev husky && npm pkg set scripts.prepare=husky && npm run prepare
# (husky v9+: a hook is a plain shell script — no sourcing boilerplate needed. We
#  set + run the prepare script rather than `husky init`, which would overwrite
#  this hook with a sample.)
#
# This template is generic. Tighten the commands to your project's actual
# lint/typecheck. The setup form's stack-commands chip selector auto-suggests
# these; what you see here is the structural skeleton.

# Lint the staged files (Added / Copied / Modified / Renamed). Paths containing
# spaces need extra quoting — tighten this for your linter if that applies.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED" ]; then
  {{LINT_COMMAND}} $STAGED
fi
#   Examples ({{LINT_COMMAND}}):
#     npm:       npx eslint --fix
#     python:    ruff check --fix
#     rust:      cargo fmt --
#     flutter:   dart format

# Project-wide type check.
{{TYPECHECK_COMMAND}}
<!-- TOGGLE:code_size_check START -->

# The code-size limits in .claude/rules/code-size.md, with the first Python 3.8+ found.
for py in python3 python py; do
  "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null && exec "$py" .github/scripts/size_check.py
done
echo "size check: no Python 3.8 or later found" >&2
exit 1
<!-- TOGGLE:code_size_check END -->
#   Examples ({{TYPECHECK_COMMAND}}):
#     ts:        npx tsc --noEmit
#     python:    mypy .
#     rust:      cargo check --all-targets
#
# Husky reads one file per git hook: the commit-message check is in
# .husky/commit-msg and the tests before each push in .husky/pre-push.
