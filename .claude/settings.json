{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" no-ai-attribution' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" || exit 0; exec sh \"$0\" push-guard' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git merge:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git remote:*)",
      "Bash(git restore:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(node -e:*)",
      "Bash(python -c:*)",
      "Bash(date:*)",
      "Bash(node --test:*)",
      "Bash(node engine/cli.js:*)",
      "Bash(python engine/bind.py:*)",
      "Bash(python -m http.server:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git fetch *--upl*)",
      "Bash(git pull *--upl*)",
      "Bash(git remote *--mi*)",
      "Bash(gh repo sync *--force*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push * develop)",
      "Bash(git push * develop *)",
      "Bash(git push *:develop)",
      "Bash(git push *:develop *)",
      "Bash(git push * refs/heads/develop)",
      "Bash(git push * refs/heads/develop *)",
      "Bash(git push *:refs/heads/develop)",
      "Bash(git push *:refs/heads/develop *)",
      "Bash(git rebase -i*)",
      "Bash(git rebase * -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase * --interactive*)",
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
